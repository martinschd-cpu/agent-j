  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
