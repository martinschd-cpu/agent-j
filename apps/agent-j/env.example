# Copy to .env.local (ignored by git) and adjust.
# true: everything runs against the in-app MockApi (default).
# false: chats and streaming go to Hermes, everything else stays mocked.
EXPO_PUBLIC_USE_MOCKS=true

# Base URL of the backend (Hermes API server or a BFF in front of it).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8642

# Development only. EXPO_PUBLIC_* values are bundled into the app and visible to anyone
# who has it. Never put the Hermes API_SERVER_KEY of a shared or production server here.
EXPO_PUBLIC_API_TOKEN=
